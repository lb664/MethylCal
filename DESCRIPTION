Package: MethylCal
Title: Bayesian Calibration of Methylation Levels
Version: 0.2.0
Authors@R: c(
    person("Leonardo", "Bottolo", email = "lb664@cam.ac.uk",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-6381-2327")),
    person("Verena", "Zuber", email = "v.zuber@imperial.ac.uk",
           role = c("aut", "ctb"),
           comment = c(ORCID = "0000-0001-9827-1877"))
